class Node:
    def __init__(self, value):
        self.value = value
        self.life = None
        self.right = None

def insert(root, value):
    if root is None:
        return Node(value)
        
    if value < root.value:
        root.life = insert(root.life, value)
    else:
        root.right = insert(root.right, value)
    return root

def preorder(node):
    if node :
        print(node.value, end=' ')
        preorder(node.life)
        preorder(node.right)
    
def inorder(node):
    if node :
        inorder(node.life)
        print(node.value, end=' ')
        inorder(node.right)

def postorder(node):
    if node :
        postorder(node.life)
        postorder(node.right)
        print(node.value, end=' ')

data = [50 , 30, 70, 20, 40]
root = None
for x in data:
    root = insert(root, x)

print("Preorder:")
preorder(root)
print("\nInorder:")
inorder(root)
print("\nPostorder:")
postorder(root)

